# Template Konfigurasi Lingkungan - Modul 3
# Salin berkas ini ke .env dan isi dengan kredensial Anda yang sebenarnya.
# JANGAN PERNAH menyimpan kredensial asli pada berkas template ini.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SECRET_KEY=your-django-secret-key-here
