  "item": [
    {
      "name": "01. Pendaftaran Calon Partner (M3-US1 & T4.2 / T5.2)",
      "description": "Endpoint publik pendaftaran mandiri partner baru. Mendukung multipart/form-data untuk dokumen KTP & selfie, validasi ketat, dan auto-generate kode PRT.",
      "item": [
        {
          "name": "01.1 Pendaftaran Sukses (Multipart Dokumen Foto & Akun)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nama_usaha", "value": "Toko Berkah Mandiri", "type": "text" },
                { "key": "kategori_usaha", "value": "Produk", "type": "text" },
                { "key": "unit_usaha_id", "value": "1", "type": "text" },
                { "key": "deskripsi_usaha", "value": "Penyedia sembako dan retail lokal berkualitas.", "type": "text" },
                { "key": "alamat_usaha", "value": "Jl. Asia Afrika No. 10, Bandung", "type": "text" },
                { "key": "nomor_telepon_usaha", "value": "081122334455", "type": "text" },
                { "key": "email_usaha", "value": "berkah.mandiri@example.com", "type": "text" },
                { "key": "penanggung_jawab_nama", "value": "Budi Santoso", "type": "text" },
                { "key": "penanggung_jawab_nik", "value": "3201234567890001", "type": "text" },
                { "key": "tempat_lahir", "value": "Bandung", "type": "text" },
                { "key": "tanggal_lahir", "value": "1990-05-15", "type": "text" },
                { "key": "password", "value": "ArayaPartner2026", "type": "text" },
                { "key": "foto_ktp", "type": "file", "src": "ktp.png" },
                { "key": "foto_memegang_ktp", "type": "file", "src": "selfie_ktp.png" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/partners/",
              "host": ["{{base_url}}"],
              "path": ["partners", ""]
            }
          }
        },
        {
          "name": "01.2 Pendaftaran Sukses (JSON Format)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_usaha\": \"Kedai Kopi Artisan M3\",\n  \"kategori_usaha\": \"Produk\",\n  \"unit_usaha_id\": 2,\n  \"deskripsi_usaha\": \"Minuman kopi lokal pilihan dan biji sangrai berkualitas.\",\n  \"alamat_usaha\": \"Jl. Riau No. 45, Bandung\",\n  \"nomor_telepon_usaha\": \"081234567890\",\n  \"email_usaha\": \"kopi.artisan@example.com\",\n  \"penanggung_jawab_nama\": \"Rian Pratama\",\n  \"penanggung_jawab_nik\": \"3273010203040005\",\n  \"tempat_lahir\": \"Bandung\",\n  \"tanggal_lahir\": \"1992-08-20\",\n  \"password\": \"KopiMantap2026\"\n}"
            },
            "url": {
