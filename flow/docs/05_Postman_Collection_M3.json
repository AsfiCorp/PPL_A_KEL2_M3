{
  "info": {
    "_postman_id": "b3c7d1e2-f4a5-4b6c-8d9e-1f2a3b4c5d6e",
    "name": "Araya Business Hub - Modul 3 (Partner Management) API v2.0",
    "description": "Koleksi pengujian resmi Kontrak Antar-Modul (K-06, K-01, M2) dan Endpoint Modul 3 (Manajemen Partner) mencakup SPRINT 1 dan SPRINT 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/m3/v1",
      "type": "string"
    },
    {
      "key": "jwt_admin",
      "value": "mock-admin-token",
      "type": "string"
    },
    {
      "key": "jwt_partner",
      "value": "mock-partner-token",
      "type": "string"
    },
    {
      "key": "service_key_m3",
      "value": "sk_m3_dev_secret",
      "type": "string"
    },
    {
      "key": "partner_id",
      "value": "PRT-20261108-A9F2",
      "type": "string"
    },
    {
      "key": "internal_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "[SPRINT 1] 01. Pendaftaran Calon Partner (M3-US1)",
      "description": "Endpoint publik pendaftaran mandiri partner baru. Mendukung multipart/form-data untuk dokumen KTP & selfie, validasi ketat, dan auto-generate kode PRT.",
      "item": [
        {
          "name": "01.1 Pendaftaran Sukses (Multipart Dokumen Foto & Akun)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nama_usaha", "value": "Toko Berkah Mandiri", "type": "text" },
                { "key": "kategori_usaha", "value": "Produk", "type": "text" },
                { "key": "unit_usaha_id", "value": "1", "type": "text" },
                { "key": "deskripsi_usaha", "value": "Menjual sembako dan kebutuhan pokok harian", "type": "text" },
                { "key": "alamat_usaha", "value": "Jl. Cibadak No. 120, Bandung", "type": "text" },
                { "key": "nomor_telepon_usaha", "value": "081298765432", "type": "text" },
                { "key": "email_usaha", "value": "berkah.mandiri@example.com", "type": "text" },
                { "key": "password", "value": "RahasiaBerkah2026", "type": "text" },
                { "key": "penanggung_jawab_nama", "value": "Ahmad Dani", "type": "text" },
                { "key": "penanggung_jawab_nik", "value": "3201234567890001", "type": "text" },
                { "key": "tempat_lahir", "value": "Bandung", "type": "text" },
                { "key": "tanggal_lahir", "value": "1990-05-15", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/partners/",
              "host": ["{{base_url}}"],
              "path": ["partners", ""]
            }
          }
        },
        {
          "name": "01.2 Duplikasi Email (Harus Ditolak 409 / 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nama_usaha", "value": "Toko Duplikat", "type": "text" },
                { "key": "kategori_usaha", "value": "Produk", "type": "text" },
                { "key": "email_usaha", "value": "berkah.mandiri@example.com", "type": "text" },
                { "key": "deskripsi_usaha", "value": "Deskripsi singkat", "type": "text" },
                { "key": "alamat_usaha", "value": "Jl. Asrama", "type": "text" },
                { "key": "nomor_telepon_usaha", "value": "081111111111", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/partners/",
              "host": ["{{base_url}}"],
              "path": ["partners", ""]
            }
          }
        },
        {
          "name": "01.3 Galat Validasi NIK Bukan 16 Digit (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nama_usaha", "value": "Toko NIK Rusak", "type": "text" },
                { "key": "kategori_usaha", "value": "Jasa", "type": "text" },
                { "key": "email_usaha", "value": "nik.rusak@example.com", "type": "text" },
                { "key": "penanggung_jawab_nik", "value": "12345", "type": "text" },
                { "key": "deskripsi_usaha", "value": "Deskripsi", "type": "text" },
                { "key": "alamat_usaha", "value": "Bandung", "type": "text" },
                { "key": "nomor_telepon_usaha", "value": "08123456789", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/partners/",
              "host": ["{{base_url}}"],
              "path": ["partners", ""]
            }
          }
        }
      ]
    },
    {
      "name": "[SPRINT 1] 02. Status Pendaftaran Partner (M3-US3)",
      "description": "Endpoint pengecekan status pendaftaran terkini. Mendukung dual lookup ID angka atau string partner_id (PRT-...).",
      "item": [
        {
          "name": "02.1 Ambil Detail via ID Numerik (1)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/partners/{{internal_id}}/",
              "host": ["{{base_url}}"],
              "path": ["partners", "{{internal_id}}", ""]
            }
          }
        },
        {
          "name": "02.2 Ambil Detail via String partner_id (PRT-...)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/partners/{{partner_id}}/",
              "host": ["{{base_url}}"],
              "path": ["partners", "{{partner_id}}", ""]
            }
          }
        },
        {
          "name": "02.3 Pengecekan ID Tidak Ada (404 NOT_FOUND)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/partners/PRT-99999999-NOTFOUND/",
              "host": ["{{base_url}}"],
              "path": ["partners", "PRT-99999999-NOTFOUND", ""]
            }
          }
        }
      ]
    },
    {
      "name": "[SPRINT 1] 03. Kontrak K-06 — Katalog Partner Terverifikasi (M3, M4, M5)",
      "description": "Endpoint penyediaan daftar partner terverifikasi untuk konsumsi Modul 5 (Katalog Publik) dan Modul 4.",
      "item": [
        {
          "name": "03.1 Ambil Daftar Partner Terverifikasi (Default)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/partners/?status=terverifikasi",
              "host": ["{{base_url}}"],
              "path": ["partners", ""],
              "query": [
                { "key": "status", "value": "terverifikasi" }
              ]
            }
          }
        },
        {
          "name": "03.2 Ambil Partner dengan Pencarian & Pagination",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/partners/?status=terverifikasi&q=Berkah&page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["partners", ""],
              "query": [
                { "key": "status", "value": "terverifikasi" },
                { "key": "q", "value": "Berkah" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "[SPRINT 2] 04. Verifikasi Partner oleh Administrator (M3-US2)",
      "description": "Endpoint pengelolaan dan verifikasi pendaftaran partner oleh Administrator.",
      "item": [
        {
          "name": "04.1 Daftar Pendaftar untuk Admin (GET /admin/partners/)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_admin}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/partners/?status=pending",
              "host": ["{{base_url}}"],
              "path": ["admin", "partners", ""],
              "query": [
                { "key": "status", "value": "pending" }
              ]
            }
          }
        },
        {
          "name": "04.2 Setujui Pendaftaran Partner (Approve & Sync M1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/partners/{{internal_id}}/verify/",
              "host": ["{{base_url}}"],
              "path": ["admin", "partners", "{{internal_id}}", "verify", ""]
            }
          }
        },
        {
          "name": "04.3 Tolak Pendaftaran Partner dengan Alasan (Reject)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"alasan_penolakan\": \"Foto KTP buram dan tidak terbaca jelas. Mohon unggah ulang.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/partners/{{internal_id}}/verify/",
              "host": ["{{base_url}}"],
              "path": ["admin", "partners", "{{internal_id}}", "verify", ""]
            }
          }
        }
      ]
    },
    {
      "name": "[SPRINT 2] 05. Tata Kelola & Penangguhan Partner (M3-US4)",
      "description": "Endpoint pembekuan (suspend) dan re-aktivasi partner oleh Administrator.",
      "item": [
        {
          "name": "05.1 Tangguhkan Partner (Suspend + Alasan Wajib)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alasan_penangguhan\": \"Terdapat laporan pelanggaran standar mutu produk dari konsumen.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/partners/{{internal_id}}/suspend/",
              "host": ["{{base_url}}"],
              "path": ["admin", "partners", "{{internal_id}}", "suspend", ""]
            }
          }
        },
        {
          "name": "05.2 Aktifkan Kembali Partner (Reactivate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_admin}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/partners/{{internal_id}}/reactivate/",
              "host": ["{{base_url}}"],
              "path": ["admin", "partners", "{{internal_id}}", "reactivate", ""]
            }
          }
        }
      ]
    },
    {
      "name": "06. Dokumentasi Interaktif & Schema",
      "description": "Endpoint akses skema kontrak OpenAPI dan antarmuka Swagger UI.",
      "item": [
        {
          "name": "06.1 Skema OpenAPI v1 (YAML)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/openapi.yaml",
              "host": ["{{base_url}}"],
              "path": ["openapi.yaml"]
            }
          }
        },
        {
          "name": "06.2 Halaman Swagger UI",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/docs/",
              "host": ["{{base_url}}"],
              "path": ["docs", ""]
            }
          }
        }
      ]
    }
  ]
}
