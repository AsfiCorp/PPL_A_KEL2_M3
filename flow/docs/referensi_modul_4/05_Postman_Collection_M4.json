      "item": [
        {
          "name": "[SUKSES 200] GET Daftar Produk Aktif (K-05)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Amplop respons memiliki success: true dan array data', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_customer}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?is_active=true&page=1&per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
